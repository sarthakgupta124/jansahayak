# JanSahayak — जनसहायक
# Bhopal, Madhya Pradesh — Property Mutation Pre-flight Prototype
# ---------------------------------------------------------------
# Everything below is optional. The prototype runs end to end with none of it set.

PORT=3001
NODE_ENV=development

# OPTIONAL — reading fields off an uploaded document photograph.
# With no key set, documents are classified by file name and the citizen
# confirms the fields themselves. The compliance engine is identical either way,
# and the app states on screen which path ran.
#
# The model NEVER decides anything. It transcribes pixels into candidate field
# values, and every value is shown to the citizen as an editable field before a
# single rule runs on it.
#
# To enable vision extraction, paste your OpenAI API key below:
# OPENAI_API_KEY=sk-...your-key-here...
# OPENAI_MODEL=gpt-4o-mini

# How long a case survives in server memory before it is discarded.
# Nothing is ever written to disk.
# CASE_TTL_MINUTES=180
# MAX_CASES=500
